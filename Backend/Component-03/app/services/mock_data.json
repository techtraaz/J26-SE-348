  "check_rules": {
    "balance_sheet": [
      {
        "rule_id": "CHK-001",
        "name": "Accounting equation",
        "expression": "assets == liabilities + capital",
        "severity": "high",
        "variables": [
          {
            "name": "assets",
            "line_item": "total_assets",
            "aliases": [
              "assets"
            ]
          },
          {
            "name": "liabilities",
            "line_item": "total_liabilities",
            "aliases": [
              "liabilities"
            ]
          },
          {
            "name": "capital",
            "line_item": "total_equity",
            "aliases": [
              "capital",
              "equity"
            ]
          }
        ]
      },
      {
        "rule_id": "CHK-004",
        "name": "Year on year change within limit",
        "expression": "abs(assets - prior.assets) / abs(prior.assets) <= 0.30",
        "severity": "medium",
        "variables": [
          {
            "name": "assets",
            "line_item": "total_assets",
            "aliases": [
              "assets"
            ]
          }
        ]
      },
      {
        "rule_id": "CHK-006",
        "name": "Required fields present",
        "expression": "required fields present and confidence >= 0.5",
        "severity": "medium",
        "variables": []
      },
      {
        "rule_id": "CHK-007",
        "name": "Total assets equals current plus non-current",
        "expression": "total_assets == total_current_assets + total_non_current_assets",
        "severity": "medium",
        "variables": [
          {
            "name": "total_assets",
            "line_item": "total_assets",
            "aliases": [
              "assets"
            ]
          },
          {
            "name": "total_current_assets",
            "line_item": "total_current_assets",
            "aliases": [
              "current_assets"
            ]
          },
          {
            "name": "total_non_current_assets",
            "line_item": "total_non_current_assets",
            "aliases": []
          }
        ]
      },
      {
        "rule_id": "CHK-009",
        "name": "Cash flow closing cash ties to SFP",
        "expression": "closing_cash == cash_and_cash_equivalents",
        "severity": "high",
        "variables": [
          {
            "name": "closing_cash",
            "line_item": "closing_cash",
            "aliases": []
          },
          {
            "name": "cash_and_cash_equivalents",
            "line_item": "cash_and_cash_equivalents",
            "aliases": [
              "cash"
            ]
          }
        ]
      },
      {
        "rule_id": "CHK-010",
        "name": "Closing equity ties to SFP",
        "expression": "closing_equity == total_equity",
        "severity": "high",
        "variables": [
          {
            "name": "closing_equity",
            "line_item": "closing_equity",
            "aliases": []
          },
          {
            "name": "total_equity",
            "line_item": "total_equity",
            "aliases": [
              "capital",
              "equity"
            ]
          }
        ]
      },
      {
        "rule_id": "CHK-011",
        "name": "Inventory not above NRV",
        "expression": "inventories <= inventory_nrv",
        "severity": "medium",
        "variables": [
          {
            "name": "inventories",
            "line_item": "inventories",
            "aliases": [
              "inventory",
              "closing_inventory"
            ]
          },
          {
            "name": "inventory_nrv",
            "line_item": "inventory_nrv",
            "aliases": []
          }
        ]
      }
    ],
    "trial_balance": [
      {
        "rule_id": "CHK-002",
        "name": "Debit equals credit",
        "expression": "debit_total == credit_total",
        "severity": "high",
        "variables": [
          {
            "name": "debit_total",
            "line_item": "total_debits",
            "aliases": [
              "debit_total"
            ]
          },
          {
            "name": "credit_total",
