# Copy to .env and fill in. All keys are optional.
# Result store (FR6). Without a URI, results live in memory only.
C03_MONGODB_URI=
C03_MONGODB_DB=nomos_xai
# C03_STORE_MODE=mongo        # mongo | memory

# Knowledge graph (Component-02 base URL, no /query suffix)
KG_MODE=auto                  # auto | mock | live
KG_URL=http://localhost:8002
KG_TIMEOUT=5
KG_SEARCH_MODE=hybrid         # keyword | semantic | hybrid (C2 standards search)
# KG_MOCK_FILE=data/kg_snapshot.json  # mock reads a live-KG snapshot (scripts/snapshot_kg.py); empty = committed mock

# Self-hosted LLM (reads Copilot requests, writes the case summary; never a verdict)
C03_LLM_ENABLED=true
C03_LLM_PROVIDER=ollama       # ollama | openai (llama.cpp, vLLM, LM Studio) | none
C03_LLM_MODEL=phi4-mini
C03_LLM_BASE_URL=http://localhost:11434   # e.g. http://localhost:8080/v1 for openai
C03_LLM_TIMEOUT=8             # audit trace line
C03_LLM_SUMMARY_TIMEOUT=90    # case summary for the auditor (a few paragraphs)
C03_COPILOT_LLM_TIMEOUT=25    # Copilot (first call loads the model)

# Copilot understanding: auto (rules when confident, else LLM) | rules | llm
C03_COPILOT_NLU=auto
C03_COPILOT_RULES_SCORE=2.5
C03_COPILOT_RULES_MARGIN=1.0
C03_COPILOT_LLM_CANDIDATES=3

# Component-04 ("generate the report" asks it for the PDF of a saved audit)
C4_URL=http://localhost:8004
C4_TIMEOUT=120

# XAI trace events for Component-04 go to MongoDB nomos_xai.c03_callback_traces (kept permanently;
# deleting a chat deletes its Copilot-turn traces)
