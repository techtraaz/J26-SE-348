# Component 01 (extraction) settings. Copy to .env in this folder and edit.
# Every setting can also be an environment variable with the same name.
# Defaults are shown; uncomment a line only to change it.

# --- Required ---------------------------------------------------------------

# PostgreSQL database for documents, runs, drafts and verified records.
# Create it first (e.g. `createdb nomos`), then run `uv run alembic upgrade head`.
NOMOS_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/nomos

# --- OCR engine -------------------------------------------------------------

# paddle = real PaddleOCR (about a minute per page on a laptop CPU).
# replay = development only: returns one saved PaddleOCR result for every upload,
#          instantly. Boxes then line up only on the document that result came from.
NOMOS_ENGINE=replay
# NOMOS_REPLAY_FIXTURE=tests/fixtures/sample_invoice.default.json
# NOMOS_REPLAY_DELAY_S=0          # simulate slow OCR to see the "processing" state

# --- Storage and limits -----------------------------------------------------

# Where uploaded files and page images are kept:
#   local = on this machine, under NOMOS_STORAGE_ROOT
#   s3    = in an S3-compatible object store such as Garage (the GARAGE_* settings below)
# Switching an existing installation to s3? Copy the local files first:
#   uv run python scripts/copy_store_to_s3.py --dry-run   (then without --dry-run)
# NOMOS_STORAGE_BACKEND=local
# NOMOS_STORAGE_ROOT=data/store   # used when the backend is local

# Object storage, used when NOMOS_STORAGE_BACKEND=s3 (no NOMOS_ prefix on these).
# GARAGE_ENDPOINT=http://localhost:3900
# GARAGE_ACCESS_KEY=YOUR_ACCESS_KEY
# GARAGE_SECRET_KEY=YOUR_SECRET_KEY
# GARAGE_BUCKET=uploads

# NOMOS_PDF_DPI=150               # PDF pages are rendered at this DPI
# NOMOS_MAX_FILE_BYTES=26214400   # 25 MB
# NOMOS_MAX_PAGES=20
# NOMOS_MAX_PIXELS_PER_PAGE=40000000

# --- Worker -----------------------------------------------------------------

# The background worker runs inside the API process and processes uploads one
# at a time. Turn it off only for tests.
# NOMOS_RUN_WORKER=true
# NOMOS_WORKER_POLL_INTERVAL_S=1.0

# --- Browser access (CORS) --------------------------------------------------

# Origins allowed to call the API: the frontend's Vite dev server by default.
# NOMOS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Tests ------------------------------------------------------------------
# To run the tests on PostgreSQL instead of a temporary SQLite file, set
# NOMOS_TEST_DATABASE_URL in the SHELL (pytest does not read this file) to an
# EMPTY throwaway database: its tables are dropped and recreated for every test.
# NOMOS_TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/nomos_test
