NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# openai = any OpenAI-compatible server, fake = no server (tests, offline work)
LLM_PROVIDER=openai
# local Ollama: http://localhost:11434/v1   RunPod vLLM: https://<pod-id>-8000.proxy.runpod.net/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=phi4-mini
# none = no thinking on reasoning models (much faster); empty = server default
LLM_REASONING_EFFORT=
# paragraphs sent at once; match the server's parallel slots (Ollama OLLAMA_NUM_PARALLEL)
LLM_WORKERS=1

# leave empty to use LLM_BASE_URL
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# read-only Cypher endpoint for people; agents use the fixed /query endpoints
QUERY_CYPHER_ENABLED=true
QUERY_CYPHER_TIMEOUT=10
QUERY_CYPHER_MAX_ROWS=500
