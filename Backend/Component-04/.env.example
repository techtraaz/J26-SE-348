# Component 04 — copy to .env and fill in. Never commit .env.

# MongoDB (shared with Component 03): traces, saved audits, report index, reviews
C04_MONGODB_URI=
C04_MONGODB_DB_NAME=nomos_xai
C04_TRACE_POLL_MS=300

# LLM for the Review Agent's summary (optional: without it a fixed wording is used)
#   Ollama:                          C04_LLM_PROVIDER=ollama  C04_LLM_API_URL=http://host:11434/api/chat
#   OpenAI-compatible (vLLM, TGI…):  C04_LLM_PROVIDER=openai  C04_LLM_API_URL=https://host/v1
C04_LLM_PROVIDER=ollama
C04_LLM_API_URL=http://localhost:11434/api/chat
C04_LLM_MODEL=phi4
C04_LLM_API_KEY=
C04_LLM_TIMEOUT=60
# Thinking models (e.g. Qwen 3.5): none turns thinking off so the answer is not cut off.
# low | medium | high | empty = the server's default.
C04_LLM_REASONING_EFFORT=

# Object storage (S3-compatible Garage) for the report PDFs
GARAGE_ENDPOINT=
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_BUCKET=uploads
C04_REPORTS_PREFIX=c04-reports

# Server
C04_HOST=0.0.0.0
C04_PORT=8004
